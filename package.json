{
  "name": "village-activity-api-testing",
  "version": "1.0.0",
  "description": "REST API Sistem Informasi Kegiatan Desa Sukamaju (Express.js + PostgreSQL)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "mocha",
    "test:serial": "mocha --no-parallel",
    "test:watch": "nodemon --watch src --watch tests --ext js,json --exec \"mocha --no-parallel\"",
    "test:report": "node scripts/test-report.mjs",
    "report:open": "allure open ./allure-report",
    "test:report:open": "npm run test:report && npm run report:open",
    "test:api": "newman run \"./postman/API - Desa Sukamaju.postman_collection.json\" --delay-request 200",
    "test:api:report": "newman run \"./postman/API - Desa Sukamaju.postman_collection.json\" --delay-request 200 -r cli,htmlextra --reporter-htmlextra-export ./postman/report.html",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "keywords": [
    "express",
    "postgresql",
    "rest-api"
  ],
  "author": "Ghifari Ezra Ramadhan",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "allure": "^3.22.1",
    "allure-js-commons": "^3.14.0",
    "allure-mocha": "^3.14.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
