{
  "name": "si-kegiatan-desa",
  "version": "1.0.0",
  "description": "REST API Sistem Informasi Kegiatan Desa Sukamaju (Express.js + PostgreSQL)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test:api": "newman run \"./postman/API - Desa Sukamaju.postman_collection.json\" --delay-request 200",
    "test:api:report": "newman run \"./postman/API - Desa Sukamaju.postman_collection.json\" --delay-request 200 -r cli,htmlextra --reporter-htmlextra-export ./postman/report.html",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "keywords": [
    "express",
    "postgresql",
    "rest-api"
  ],
  "author": "Naila Putri Fahel",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14"
  }
}
