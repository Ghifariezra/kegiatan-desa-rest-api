        {
          "name": "Hapus Akun Warga",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "const jsonData = pm.response.json();",
                  "const data = jsonData.data || {};",
                  "const idDiUrl = Number(",
                  "    pm.variables.replaceIn(pm.request.url.path[pm.request.url.path.length - 1])",
                  ");",
                  "const akunId = Number(pm.collectionVariables.get(\"akun_id\"));",
                  "const hapusAkunHasilPost = idDiUrl === akunId;",
                  "",
                  "let akunTerakhir = null;",
                  "try {",
                  "    akunTerakhir = JSON.parse(pm.collectionVariables.get(\"akun_terakhir\"));",
                  "} catch (e) {",
                  "    akunTerakhir = null;",
                  "}",
                  "",
                  "pm.test(\"Status code harus 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type berupa JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"status dan message sesuai\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.message).to.eql(\"Akun warga berhasil dihapus\");",
                  "});",
                  "",
                  "pm.test(\"data yang dikembalikan adalah akun yang dihapus\", function () {",
                  "    pm.expect(data).to.be.an(\"object\");",
                  "    pm.expect(data.id).to.eql(idDiUrl);",
                  "    pm.expect(data).to.have.all.keys(",
                  "        \"id\", \"warga_id\", \"nama_lengkap\", \"email\", \"peran\", \"created_at\"",
                  "    );",
                  "    if (hapusAkunHasilPost && akunTerakhir) {",
                  "        pm.expect(data).to.eql(akunTerakhir);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"password dan password_hash tidak bocor\", function () {",
                  "    pm.expect(data).to.not.have.property(\"password\");",
                  "    pm.expect(data).to.not.have.property(\"password_hash\");",
                  "});",
                  "",
                  "pm.test(\"Response time di bawah 500 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "// Verifikasi: GET ke ID yang sama harus 404 karena datanya sudah terhapus",
                  "pm.sendRequest(",
                  "    pm.variables.replaceIn(\"{{ENDPOINT_API}}/akun-warga/\" + idDiUrl),",
                  "    function (err, res) {",
                  "        pm.test(\"Akun benar-benar terhapus (GET ulang menghasilkan 404)\", function () {",
                  "            pm.expect(err).to.be.null;",
                  "            pm.expect(res).to.have.property(\"code\", 404);",
                  "            pm.expect(res.json().status).to.eql(\"error\");",
                  "            pm.expect(res.json().message).to.eql(",
                  "                `Akun warga dengan id ${idDiUrl} tidak ditemukan`",
                  "            );",
                  "        });",
                  "    }",
                  ");",
                  "",
                  "// Bersihkan variable hanya kalau yang terhapus memang akun hasil POST",
                  "if (pm.response.code === 200 && hapusAkunHasilPost) {",
                  "    pm.collectionVariables.unset(\"akun_id\");",
                  "    pm.collectionVariables.unset(\"akun_terakhir\");",
                  "}",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
